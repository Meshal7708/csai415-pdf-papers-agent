# Copy to .env and `source .env` (or let docker-compose / your shell load it).
# Leave a URL blank to use the in-process fallback for that store
# (mongomock / Qdrant :memory: / NetworkX). With everything blank, D3 runs
# fully offline from the committed cache — no services, no Docker.

# ---- stores (point at the docker-compose services for service mode) ----
MONGO_URI=
MONGO_DB=papers_ai

QDRANT_URL=
QDRANT_COLLECTION=chunks
# QDRANT_PATH=data/qdrant_db        # on-disk local Qdrant instead of :memory:

NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=test1234

# ---- embedder ----
# bge  = BAAI/bge-small-en-v1.5 via fastembed (ONNX, CPU, no torch) — default,
#        and what the committed data/embeddings.npz was built with.
EMBEDDER=bge
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Optional: reuse an existing HF/fastembed model cache instead of re-downloading
# FASTEMBED_CACHE_PATH=/path/to/hf/hub

# ---- retrieval ----
# Frozen from the D1 Optuna winner; the D1 online learner adapts this knob.
HYBRID_LAMBDA=0.5

# ---- optional answerer ----
# Set to use an LLM answerer instead of the default extractive one.
# OPENAI_API_KEY=sk-...
