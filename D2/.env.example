# Copy to .env and `source .env` (or let docker-compose/your shell load it).
# Leave a URL blank to use the in-process fallback for that store
# (mongomock / Qdrant :memory: / NetworkX) — handy for tests, ephemeral.

# ---- stores (point at the docker-compose services) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=papers_ai

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test1234

# ---- embedder ----
# bge  = BAAI/bge-small-en-v1.5 via fastembed (ONNX, CPU, no torch) — default
# hash = offline deterministic embedder, only for fast CI smoke tests
EMBEDDER=bge
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Optional: reuse an existing HF/fastembed model cache instead of re-downloading
# FASTEMBED_CACHE_PATH=/path/to/hf/hub

# ---- retrieval ----
# Frozen from the D1 Optuna winner; the D1 online learner adapts this knob.
HYBRID_LAMBDA=0.5
